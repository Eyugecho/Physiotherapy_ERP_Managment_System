    <record id="prperty_managment_tree_report" model="ir.ui.view" >
    <field name="name">maintenance.equipment.view.tree.inherit</field>
    <field name="model">maintenance.equipment</field>
    <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='category_id']" position="after">
                <field name="effective_date" />
                <field name="cost" widget="Cost" /> 
                <field name="serial_no" widget="Serial Number" optional= "hide"/>
                <field name="storage_type" widget="HardDisk Type" optional= "hide"/>
                <field name="processor" widget="Processor Speed" optional= "hide"/>
                 <field name="memory" widget="memory Speed" optional= "hide"/>
        </xpath>
        <xpath expr="//tree" position="attributes">
            <attribute name = "editable"/>
        </xpath>
    </field>
</record>



       <record id="property_report_action_droga1" model="ir.actions.act_window">
            <field name="name">Property Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">maintenance.equipment</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="droga_maintenance.prperty_managment_tree_report"/>
        </record> 
		    
