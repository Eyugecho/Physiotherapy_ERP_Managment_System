<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="helpdesk_ticket_report_report" model="ir.actions.report">
            <field name="name">Helpdesk - Employee Report</field>
            <field name="model">helpdesk.ticket.wizard.report</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">helpdesk_report.helpdesk_ticket_report_template</field>
            <field name="report_file">helpdesk_report.helpdesk_ticket_report_template</field>
            <field name="print_report_name">'Helpdesk Report - By User'</field>
            <field name="binding_model_id" ref="model_helpdesk_ticket_wizard_report"/>
            <field name="binding_type">report</field>
        </record>
    </data>



    <template id="helpdesk_ticket_report_template">
        <t t-call="web.html_container">

            <t t-call="web.external_layout">
               <style>
                #mytable thead th tbody td {
                    font-size: 8xp;
                    font-weight:bold;
                    padding:5px;
                    text-align: right;
                }

                h2 {
                    text-align: left;
                }

                th {
                    text-align: left;
                }
                </style>


                <t t-foreach="docs" t-as="doc">

                  <h2>Helpdesk - User Report</h2>
                  <!-- <h1>doc./h1> -->
                        <span t-field="doc.date_from"/> - <span t-field="doc.date_to"/> 
                    <hr/>

                    <table id="mytable" class="table table-bordered">
                        <thead style="color: black">
                            <tr>
                                <th>SN</th>
                                <th>User</th>
                                <!-- <th>A. Handle Time</th> -->
                                <th>Total Tickets</th>
                                <th>Total Open Ticket</th>
                                <th>Total Closed Ticket</th>

                                <th>Total Satisfied Ratings</th>
                                <th>Total Good Ratings</th>
                                <th>Total Bad Ratings</th>
                                <th>Total Not Rated</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.helpdesk_ticket_by_employee()" t-as="result">
                                <tr>

                                <td>
                                    <span t-esc="result_index + 1"/>
                                </td>

                                <td>
                                    <t t-esc="result['user']"/>
                                </td>

                                <td>
                                    <t t-esc="result['total_tickets']"/>
                                </td>

                                <td>
                                    <t t-esc="result['total_open_tickets']"/>
                                </td>

                                <td>
                                    <t t-esc="result['total_closed_tickets']"/>
									
                                </td>
								
								
                                <td>
                                    <t t-esc="result['total_satisfied_tickets']"/>
                                </td>

                                <td>
                                    <t t-esc="result['total_good_tickets']"/>
                                </td>
								
                                <td>

                                    <t t-esc="result['total_bad_tickets']"/>
                                </td>


                                <td>
                                    <t t-esc="result['total_not_rated_tickets']"/>
                                </td>

                            </tr>
                        </t>
                    </tbody>
                </table>

            </t>
        </t>
    </t>
</template>



</odoo>
