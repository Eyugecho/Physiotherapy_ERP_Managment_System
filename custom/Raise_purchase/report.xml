<template id="custom_invoice_report_template_22" inherit_id="account.report_invoice_document">
<xpath expr="//div[@class='row']" position="after">
 
           <div class="row">
                    <div class="col-xs-8">
                        <div t-raw="0"/>
                    </div>
                    <!-- New table on the right with fixed position and smaller size -->
                     <div  style="position: fixed; top: 20px; right: 30px; width: 350px; font-size:12px;">
                     <strong>Invoice #:</strong>
                 <strong t-field="o.payment_reference"></strong>
                     </div>
                    <div  style="position: fixed; top: 0px; right: 30px; width: 350px; font-size:12px;">
                          
                                <t t-if="o.move_type == 'out_invoice'"><strong> Date:</strong></t>
                                <t t-elif="o.move_type == 'out_refund'"><strong>  Date:</strong></t>
                                <t t-elif="o.move_type == 'out_receipt'"><strong> Date:</strong></t>
                                <t t-else=""><strong>Date:</strong></t>
                                <span class="m-0" t-field="o.invoice_date"></span>
                              
                     </div>
                    
                    <div class="col-xs-4">

                        <table class="table table-condensed table-sm" style="position: fixed; top: 60px; right: 30px; width: 350px; font-size:12px;">
                            <tr >
                                <td style="width:40%; font-size:12px;">Country of Origin</td>
                                <td t-esc="o.order_sales_id.country_orgin.name or ''"/>
                            </tr>
                            <tr>
                                <td style="width:40%"> Country of Destination</td>
                                <td t-esc="o.order_sales_id.country_destination.name or ''"/>
                            </tr>
                            <tr>
                                <td>HS Code</td>
                                <td t-esc="o.order_sales_id.hs_code or ''"/>
                            </tr>
                        </table>
                     
                     
                    </div>
                    
                        
                </div>
  
</xpath>
<xpath expr="/t/t/div[3]/div[1]/table/thead/tr/th[2]" position="after">
    <th>
      <span>Unit of Measure</span>
    </th>
  </xpath>
  <xpath expr="/t/t/div[3]/div[1]/table/tbody/t[3]/tr/t[1]/td[2]" position="after">
    <td>
      <span t-field="line.product_uom_id"/>
    </td>
  </xpath>
  <xpath expr="/t/t/div[3]/div[1]/table/tbody/t[3]/t[3]/tr/td" position="attributes">
    <attribute name="colspan">100</attribute>
  </xpath>
<xpath expr="//div[@class='row']" position="replace">
        <div >
                        <strong style=" top: 30px; ">Shipped To:</strong>
                       
                    <p>
                        <span t-if="o.partner_id.name" t-field="o.partner_id.name"/>
                        <br/>
                        <span t-if="o.partner_id.phone" t-field="o.partner_id.phone"/>
                        <br/>
                        <span t-if="o.partner_id.email" t-field="o.partner_id.email"/>
                        <br/>
                        <span>Street:</span><span t-if="o.partner_id.street" t-field="o.partner_id.street"/>
                        <br/>
                        <span>Contact Person:</span><span t-if="o.partner_id.condtact_p" t-field="o.partner_id.condtact_p"/>   

                        <!-- <span>Contact Person:</span><span t-if="o.partner_id.contact_person" t-field="o.partner_id.contact_person"/>    -->
                        <br/>
                        <span>City:</span><span t-if="o.partner_id.city" t-field="o.partner_id.city"/>   
                        <br/>
                        
                        <!-- <span t-if="doc.partner_id.city" t-field="doc.partner_id.city"/>    -->
                        <br/>
                        <!-- <span t-if="doc.partner_id.address" t-field="doc.partner_id.address"/> -->
                    </p>
                     <!-- <p>
                      <strong>Customer:</strong>   <b><span t-if="o.partner_shipping_id" t-field="o.partner_shipping_id"/></b>
                        <br/>
                      <strong>Email:</strong>   <b>  <span t-if="o.partner_shipping_id.email" t-field="o.partner_shipping_id.email"/></b>
                        <br/>
                       <strong>Phone:</strong>   <b>     <span t-if="o.partner_shipping_id.phone" t-field="o.partner_shipping_id.phone"/> </b>
                        <br/>
                      <strong>City:</strong>   <b><span t-if="o.order_sales_id.partner_shipping_id.city" t-field="o.order_sales_id.partner_shipping_id.city"/></b>
                    </p> -->
            <div t-if="o.partner_shipping_id and (o.partner_shipping_id != o.partner_id)">
                <div class="col-6">
                    <div t-set="information_block">
                        <div groups="account.group_delivery_invoice_address" name="shipping_address_block">
                            <strong>Customer Address:</strong>
                            <div t-field="o.partner_shipping_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        </xpath>

</template>

<template id="custom_invoice_report_template_customer_bottom_test" inherit_id="account.report_invoice_document">
            <xpath expr="//div[@class='page']" position="after">
