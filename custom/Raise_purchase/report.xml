                    <span>Port of Loading:</span>   <span t-if="doc.loding_port" t-field="doc.loding_port"/><br/>
                    <span>Price Validation Period:</span>   <span t-if="doc.payment_term_id" t-field="doc.payment_term_id"/><br/>
                    <span>Benficiary Bank:</span>   <span t-if="doc.benfi_bank" t-field="doc.benfi_bank.name"/>,
                    <span t-if="doc.benfi_bank" t-field="doc.benfi_bank.bic"/><br/>
               

                    <span>Manufactured By:</span>   <span t-if="doc.manufacturer" t-field="doc.manufacturer"/>,
                    <span t-if="doc.manufacturer" t-field="doc.manufacturer.sub_city"/>,
                    <span t-if="doc.manufacturer" t-field="doc.manufacturer.street"/>,
                    <span t-if="doc.manufacturer" t-field="doc.manufacturer.state"/>,


<!-- 
                    <span>Manufactured By:</span>   <span t-if="o.order_sales_id.manufacturer" t-field="o.order_sales_id.manufacturer"/><br/>,
                    <span>Manufactured By:</span>   <span t-if="o.order_sales_id.manufacturer." t-field="o.order_sales_id.manufacturer"/><br/> -->

                    </p>
        </div>    
            <div style="top:50px">
                    <p>
                    <span>Mr.Lucas Dechasa Biru</span>   <br/>

                    <span>General Manager</span>  <br/>
                    <span>RISE Global GmbH</span> <br/>
                    <span>Subbelrather Strasse 15a</span>  <br/>
                    <span>Köln ,50823 Germany</span>  <br/>
       


                    </p>
            </div>

