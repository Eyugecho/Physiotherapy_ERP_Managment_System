                     <span>Origin of Goods:</span><span t-esc="o.order_sales_id.country_orgin.name or ''"/>
                    <!-- <span>Benficiary Bank:</span>   <span t-if="o.benfi_bank" t-field="o.benfi_bank.name"/>, -->

                    <!-- <span>Manufactured By:</span>   <span t-if="o.manufacturer" t-field="o.manufacturer"/>, -->

                    <!-- <span>Shipping Instruction:</span>   <span t-if="o.order_sales_id.mode_shipment" t-field="o.order_sales_id.mode_shipment"/><br/> -->


                    <!-- <span>Port of Destn:</span>   <span t-if="o.order_sales_id.destination_port" t-field="o.order_sales_id.destination_port"/><br/> -->
             



                    </p>
 </div>
                </div>
                </div>
            </xpath>
</template>

