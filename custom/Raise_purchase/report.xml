<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <template id="custom_invoice_report_template" inherit_id="sale.report_saleorder_document">
      
            <xpath expr="//div[@class='page']" position="inside">
                <!-- Move the existing content to the left -->
                <div class="row">
                    <div class="col-xs-8">
                        <div t-raw="0"/>
                    </div>

                    <!-- New table on the right with fixed position and smaller size -->
                    <div  style="position: fixed; top: 20px; right: 30px; width: 350px; font-size:12px;">
                        <strong>PI #:   <span t-field="doc.name"/> </strong>
                   
                    </div>
                    <div  style="position: fixed; top: 0px; right: 30px; width: 350px; font-size:12px;">
                             <div t-if="doc.date_order"  name="informations_date">
                                <strong t-if="doc.state in ['draft', 'sent']">Date:</strong>
                                <strong t-else="">Date:</strong>
                                <span class="m-0" t-field="doc.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;}"></span>
                            </div>
                    </div>
                    <div class="col-xs-4">
                        <table class="table table-condensed table-sm" style="position: fixed; top: 60px; right: 30px; width: 350px; font-size:12px;">
                            <tr >
                                <td style="width:40%; font-size:12px;">Country of Origin</td>
                                <td t-esc="doc.country_orgin.name or ''"/>
                            </tr>
                            <tr>
                                <td style="width:40%"> Country of Destination</td>
                                <td t-esc="doc.country_destination.name or ''"/>
                            </tr>
                            
                            <tr>
                                <td>Term of Payment</td>
                                <td t-esc="doc.payment_term_id.name or ''"/>
                            </tr>
                            <tr>
                                <td>Inconterm</td>
                                <td t-esc="doc.inconterm.name or ''"/>
                            </tr>
                        </table>
                        <!-- <table class="table table-condensed" style="position: fixed; top: 80px; bottom: 20px; right: 30px; width: 350px; font-size:12px;">
                      
                        </table> -->
                        <!-- <table class="table table-condensed">
                            <thead>
                                <tr>
                                    <th>Number of Boxes</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td t-esc="line.box_qty"/>
                                </tr>
                            </tbody>
                        </table> -->
                    </div>
                </div>
            </xpath>
            <xpath expr="//t[@t-set='address']" position="replace">
             
                    <div t-set="address">
                  
                          <div t-set="address">
                                <div t-field="doc.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>
                                <p t-if="doc.partner_id.vat"><t t-out="doc.company_id.account_fiscal_country_id.vat_label or 'Tax ID'"/>: <span t-field="doc.partner_id.vat"/></p>
                        </div>
                    </div>
            </xpath>
             <!-- <xpath expr="//table[@class='table table-sm o_main_table table-borderless mt-4']" position="inside">
             <table class="table table-condensed">
                            <thead>
                                <tr>
                                    <th>Number of Boxes</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td t-esc="line.box_qty"/>
                                </tr>
                            </tbody>
                        </table>
             </xpath> -->
        </template>
        
        <template id="custom_invoice_report_template_customer" inherit_id="sale.report_saleorder_document">
        
            <xpath expr="//div[@class='page']" position="before">
            <div class="row mt-4 mb-2" id="customer_details  float-left">
                <div class="col-auto col-6 mw-100 mb-2 float-left" style=" top: 0px; ">

                <strong>Supplier:</strong><br/>
                    <p>
                        
                     <span t-if="doc.company_id" t-field="doc.company_id.name"/><br/>
                     <span t-if="doc.company_id" t-field="doc.company_id.street"/><br/>

                     <span>Tel:</span><span t-if="doc.company_id" t-field="doc.company_id.phone"/>
                     ,<span t-if="doc.company_id" t-field="doc.company_id.mobile"/><br/>
                    <span>Email:</span><span t-if="doc.company_id" t-field="doc.company_id.email"/><br/>
                    <span t-if="doc.company_id" t-field="doc.company_id.website"/><br/>
                <div style=" top: 30px; ">
                <!-- <strong >Shipped To:</strong><br/> -->
                                    <p>
                                        <span t-if="doc.partner_id.name" t-field="doc.partner_id.name"/>
                                        <br/>
                                        <span>Tel:</span><span t-if="doc.partner_id.phone" t-field="doc.partner_id.phone"/>
                                        <br/>
                                        <span>Email:</span><span t-if="doc.partner_id.email" t-field="doc.partner_id.email"/>
                                        <br/>
                                        <span>Contact Person:</span><span t-if="doc.partner_id.condtact_p" t-field="doc.partner_id.condtact_p"/>   
                                        <br/>
                                        <span>Sub City:</span><span t-if="doc.partner_id.street" t-field="doc.partner_id.street"/>
                                        <br/>
                                        <span>Woreda:</span><span t-if="doc.partner_id.city" t-field="doc.partner_id.city"/>   
                                        <br/>
                                    </p>
                </div>
                  
                    





                    </p>
                </div>
              
            </div>
            
          </xpath>

              <xpath expr="/t/t/div[3]/table/thead/tr/th[1]" position="after">
    <th>
      <span>HS Code</span>
    </th>
  </xpath>
  <xpath expr="/t/t/div[3]/table/tbody/t[2]/tr/t[1]/td[1]" position="after">
    <td>
      <span t-field="line.hs_code"/>
    </td>
  </xpath>
  <xpath expr="/t/t/div[3]/table/tbody/t[2]/t[3]/tr/td" position="attributes">
    <attribute name="colspan">100</attribute>
  </xpath>
  <xpath expr="/t/t/div[3]/table/thead/tr/th[3]" position="after">
    <th>
      <span>Box Qty.</span>
    </th>
  </xpath>
  <xpath expr="/t/t/div[3]/table/tbody/t[2]/tr/t[1]/td[3]" position="after">
    <td>
      <span t-field="line.box_qty"/>
    </td>
  </xpath>
  <xpath expr="/t/t/div[3]/table/tbody/t[2]/t[3]/tr/td" position="attributes">
    <attribute name="colspan">101</attribute>
  </xpath>
            </template>


                   <template id="custom_invoice_report_template_customer_bottom" inherit_id="sale.report_saleorder_document">
            <xpath expr="//div[@class='page']" position="after">
            <div class="row mt-4 " id="customer_details  ">
                <div class="col-auto col-6 mw-100  " >
<!--                 
                 <t t-foreach="lines_to_report" t-as="line">
                                          <span t-field="line.name" t-options="{'widget': 'text'}"/>,

                 </t>                          -->
                       
        <div style="top:0px">
                     <!-- <strong>Shipping info:</strong><br/> -->
                    <p>
                    <span>Shipping Instruction:</span>   <span t-if="doc.mode_shipment" t-field="doc.mode_shipment"/><br/>
