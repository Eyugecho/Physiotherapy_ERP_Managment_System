    <record id="inherit_view_id_inherit_sale_raise_order" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="container" />
                <field name="num_container" />
                <field name="max_volume" />
                <field name="remaining_volume" />
                <field name="total_volume" />
                <field name="benfi_bank" />

                 <field name="manufacturer" />
                 

            </xpath>
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="country_orgin" />
                <field name="country_destination" />
                <field name="loding_port"/> 
                <field name="destination_port"/>
                <field name="port_discharge" widget="many2many_tags"/>
                <field name="inconterm" />

                <field name="mode_shipment"/>
                <!-- <field name="lc_number" /> -->
              
               
              
            </xpath>

            <xpath expr="//tree" position="inside">
            <field name="manufacturer" invisible="True" />
            <field name="product_int"  invisible="True"/>
           <field name="pakage" context="{'default_product_id': product_template_id}"  
           domain="[('product_id.id', '=', product_int)]"
           >
           <!-- <attribute name="domain">[('product_id.id', '=',product_int)] "</attribute> -->
            </field>
            <field name="total_volume" />
            <field name="max_quantity" string="Pakage Quantity"/>
            <field name="box_qty" string="Pakage Qty." />
            <field name="remaining_quantity" string="Remaning Quantity"/>
            
        </xpath>
        </field>
    </record>

