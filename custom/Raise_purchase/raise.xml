  <record id="account_move_form_view_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group" position="inside">
                <group>
                    <field name="lc_number" string="LC Number"/>
                    <field name="place_delivery"  string="Place of Delivery"/>


            
                </group>
            </xpath>
        </field>
    </record>

   

    <record id="res_partner_form_view_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <group>
                    <field name="condtact_p"/>
                  

                    
            
                </group>
            </xpath>
               
        </field>
    </record>
    <record id="inherit_raise_id_inherit_product_template" model="ir.ui.view">
